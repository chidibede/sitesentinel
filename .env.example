META_API_KEY=your_meta_api_key_here

# AWS credentials (for SST deployment)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
