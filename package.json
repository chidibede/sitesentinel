{
  "name": "sitesentinel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "pnpm --filter @sitesentinel/dev-api start",
    "dev:web": "pnpm --filter @sitesentinel/web dev",
    "build": "sst build",
    "deploy": "sst deploy",
    "remove": "sst remove",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "smoke": "tsx packages/core/scripts/smoke-test.ts",
    "inspect": "tsx packages/core/scripts/inspect.ts",
    "loop": "tsx packages/core/scripts/agent-loop.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.709.0",
    "@aws-sdk/client-s3": "^3.709.0",
    "@aws-sdk/lib-dynamodb": "^3.709.0",
    "@aws-sdk/s3-request-presigner": "^3.709.0",
    "aws4fetch": "^1.0.18",
    "openai": "^4.77.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "sst": "^3.3.33",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.8"
  },
  "workspaces": [
    "packages/*",
    "infra"
  ]
}
